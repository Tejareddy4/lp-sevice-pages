# Apache / LiteSpeed. Nginx ignores this file.

<IfModule mod_rewrite.c>
RewriteEngine On

# Country folders are lowercase (croatia/, australia/, czech-republic/), like the
# canonical and sitemap URLs. Send the old capitalised /Croatia/... URLs there.
RewriteCond %{REQUEST_URI} !/images/
RewriteCond %{REQUEST_URI} ^(.*)/Croatia(/.*)?$
RewriteRule ^ %1/croatia%2 [R=301,L]
</IfModule>

# Settings only, never served.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>
